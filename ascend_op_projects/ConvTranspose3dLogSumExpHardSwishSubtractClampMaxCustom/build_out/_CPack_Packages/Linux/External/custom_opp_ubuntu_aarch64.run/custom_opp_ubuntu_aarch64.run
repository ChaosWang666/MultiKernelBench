    \"--header\" \\
    \"/mnt/workspace/claude_code/MultiKernelBench/ascend_op_projects/ConvTranspose3dLogSumExpHardSwishSubtractClampMaxCustom/cmake/util/makeself/makeself-header.sh\" \\
    \"--help-header\" \\
    \"./help.info\" \\
    \"--tar-format\" \\
