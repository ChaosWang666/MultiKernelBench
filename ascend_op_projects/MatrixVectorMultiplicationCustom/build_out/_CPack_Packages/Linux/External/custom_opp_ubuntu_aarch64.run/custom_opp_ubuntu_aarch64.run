    fi
    if [ -L "$tmpdir" ]; then
        tmpdir=`readlink -f $tmpdir`
    fi
    if [ ! -d "$tmpdir" ]; then
        mkdir $dashp "$tmpdir" || {
        echo 'Cannot create target directory' $tmpdir >&2
        echo 'You should try option --extract=<path>' >&2
        eval $finish
        exit 1
