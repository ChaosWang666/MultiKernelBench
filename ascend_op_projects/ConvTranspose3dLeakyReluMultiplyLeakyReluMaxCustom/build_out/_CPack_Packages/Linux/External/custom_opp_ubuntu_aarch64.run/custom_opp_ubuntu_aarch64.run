        echo 'Cannot create target directory' $tmpdir >&2
        echo 'You should try option --extract=<path>' >&2
        eval $finish
        exit 1
        }
    fi
fi
tmpdir=`readlink -f $tmpdir`

location="`pwd`"
if test x"$SETUP_NOCHECK" != x1; then
    MS_Check "$0"
fi
offset=`head -n "$skip" "$0" | wc -c | tr -d " "`

if test x"$verbose" = xy; then
