	echo Build command was: "/mnt/workspace/claude_code/MultiKernelBench/ascend_op_projects/Convtranspose2dSoftmaxBiasaddScalingSigmoidCustom/cmake/util/makeself/makeself.sh \\
    \"--header\" \\
    \"/mnt/workspace/claude_code/MultiKernelBench/ascend_op_projects/Convtranspose2dSoftmaxBiasaddScalingSigmoidCustom/cmake/util/makeself/makeself-header.sh\" \\
    \"--help-header\" \\
    \"./help.info\" \\
    \"--tar-format\" \\
    \"posix\" \\
