	log "INFO" "Extract files to targetdir."
    echo "Makeself logfile: $log_file"
    ;;
    --nox11)
	nox11=y
	shift
	;;
    --xwin)
	if test "n" = n; then
		finish="echo Press Return to close this window...; read junk"
	fi
	xterm_loop=1
	shift
	;;
    --phase2)
	copy=phase2
	shift
	;;
    *)
	Script_Args_Check $1
	scriptargs="$scriptargs '$1'"
    shift
    ;;
