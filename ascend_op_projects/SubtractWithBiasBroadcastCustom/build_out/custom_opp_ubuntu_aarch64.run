	echo Built with Makeself version 2.5.0
	echo Build command was: "/mnt/workspace/claude_code/MultiKernelBench/ascend_op_projects/SubtractWithBiasBroadcastCustom/cmake/util/makeself/makeself.sh \\
    \"--header\" \\
    \"/mnt/workspace/claude_code/MultiKernelBench/ascend_op_projects/SubtractWithBiasBroadcastCustom/cmake/util/makeself/makeself-header.sh\" \\
    \"--help-header\" \\
    \"./help.info\" \\
    \"--tar-format\" \\
    \"posix\" \\
    \"--gzip\" \\
    \"--complevel\" \\
    \"4\" \\
    \"--nomd5\" \\
