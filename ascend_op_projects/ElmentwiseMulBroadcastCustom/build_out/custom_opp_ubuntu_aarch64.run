SHA_ARG=""
SIGNATURE=""
TMPROOT=${TMPDIR:="/home/tmpdir"}

if ! test -d "$TMPROOT"; then
    TMPROOT="$HOME"
fi
if ! test -d "$TMPROOT"; then
    TMPROOT="$PWD"
fi
export TMPDIR="$TMPROOT"
USER_PWD="$PWD"
if ! test -d "$USER_PWD"; then
    exit 1
fi
export USER_PWD
ARCHIVE_DIR=`dirname "$0"`
export ARCHIVE_DIR

name_of_file="$0 "
package_name=`echo $name_of_file | cut -d "/" -f2 | sed "s/.run//g" `
