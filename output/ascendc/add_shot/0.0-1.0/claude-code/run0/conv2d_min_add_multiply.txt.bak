kernel_src="""
#include "kernel_operator.h"

class KernelConv2dMinAddMultiply {
public:
    __aicore__ inline KernelConv2dMinAddMultiply() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR bias, GM_ADDR y,
                                uint32_t totalLength, uint32_t channels, uint32_t HW,
                                float constantValue, float scalingFactor)
    {
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->HW = HW;
        this->channels = channels;
        this->constantValue = constantValue;
        this->scalingFactor = scalingFactor;
        this->planesPerBlock = this->blockLength / HW;
        this->startPlaneIdx = AscendC::GetBlockIdx() * this->planesPerBlock;

        uint32_t blockOffset = this->blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ DTYPE_X *)x + blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ DTYPE_Y *)y + blockOffset, this->blockLength);
        biasGm.SetGlobalBuffer((__gm__ DTYPE_BIAS *)bias, channels);

        pipe.InitBuffer(inQueueX, 1, this->HW * sizeof(DTYPE_X));
        pipe.InitBuffer(outQueueY, 1, this->HW * sizeof(DTYPE_Y));
        pipe.InitBuffer(biasBuf, channels * sizeof(DTYPE_BIAS));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<DTYPE_BIAS> biasLocal = biasBuf.Get<DTYPE_BIAS>();
        AscendC::DataCopy(biasLocal, biasGm, this->channels);

        event_t eventIdMte2ToS = static_cast<event_t>(0);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(eventIdMte2ToS);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(eventIdMte2ToS);

        for (uint32_t p = 0; p < this->planesPerBlock; p++) {
            uint32_t channelIdx = (this->startPlaneIdx + p) % this->channels;
            DTYPE_BIAS biasVal = biasLocal.GetValue(channelIdx);

            CopyIn(p);
            Compute(p, biasVal);
            CopyOut(p);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t p)
    {
        AscendC::LocalTensor<DTYPE_X> xLocal = inQueueX.AllocTensor<DTYPE_X>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(this->HW * sizeof(DTYPE_X)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<DTYPE_X> padParams{false, 0, 0, 0};
        AscendC::DataCopyPad(xLocal, xGm[p * this->HW], copyParams, padParams);
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t p, DTYPE_BIAS biasVal)
    {
        AscendC::LocalTensor<DTYPE_X> xLocal = inQueueX.DeQue<DTYPE_X>();
        AscendC::LocalTensor<DTYPE_Y> yLocal = outQueueY.AllocTensor<DTYPE_Y>();

        AscendC::Mins(yLocal, xLocal, static_cast<DTYPE_X>(this->constantValue), this->HW);
        AscendC::Adds(yLocal, yLocal, static_cast<DTYPE_X>(biasVal), this->HW);
        AscendC::Muls(yLocal, yLocal, static_cast<DTYPE_Y>(this->scalingFactor), this->HW);

        outQueueY.EnQue<DTYPE_Y>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t p)
    {
        AscendC::LocalTensor<DTYPE_Y> yLocal = outQueueY.DeQue<DTYPE_Y>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(this->HW * sizeof(DTYPE_Y)), 0, 0, 0};
        AscendC::DataCopyPad(yGm[p * this->HW], yLocal, copyParams);
        outQueueY.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueY;
    AscendC::TBuf<AscendC::TPosition::VECCALC> biasBuf;
    AscendC::GlobalTensor<DTYPE_X> xGm;
    AscendC::GlobalTensor<DTYPE_Y> yGm;
    AscendC::GlobalTensor<DTYPE_BIAS> biasGm;
    uint32_t blockLength;
    uint32_t HW;
    uint32_t channels;
    uint32_t planesPerBlock;
    uint32_t startPlaneIdx;
    float constantValue;
    float scalingFactor;
};

extern "C" __global__ __aicore__ void conv2d_min_add_multiply_custom(GM_ADDR x, GM_ADDR bias, GM_ADDR y, GM_ADDR workspace, GM_ADDR tiling) {
    GET_TILING_DATA(tiling_data, tiling);
    KernelConv2dMinAddMultiply op;
    op.Init(x, bias, y, tiling_data.totalLength, tiling_data.channels, tiling_data.HW,
            tiling_data.constantValue, tiling_data.scalingFactor);
    op.Process();
}
